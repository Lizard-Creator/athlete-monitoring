{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "weeklyMatrix",
  "position": {
    "x": 20,
    "y": 395,
    "z": 5000,
    "height": 310,
    "width": 830,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Players"
                    }
                  },
                  "Property": "Player"
                }
              },
              "queryRef": "Players.Player",
              "nativeQueryRef": "Player"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Week Start"
                }
              },
              "queryRef": "Date.Week Start",
              "nativeQueryRef": "Week Start"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sessions"
                    }
                  },
                  "Property": "sRPE (AU)"
                }
              },
              "queryRef": "Sessions.sRPE (AU)",
              "nativeQueryRef": "sRPE (AU)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Weekly sRPE per player'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
