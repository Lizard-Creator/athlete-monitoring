	measure 'Distance (km)' = ```
			DIVIDE(SUM(Sessions[total_distance_m]), 1000)
			```
		formatString: #,0.0
		displayFolder: Load
		lineageTag: d74f2ac6-b830-5e98-89da-806847d7ba5b

	measure 'HSR (m)' = ```
