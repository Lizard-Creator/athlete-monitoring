			```
		formatString: #,0
		displayFolder: Load
		lineageTag: 82e8d1a8-e1e6-50e2-8770-4b9f299a4152

	measure 'Matches Played' = ```
			CALCULATE(COUNTROWS(Sessions), Sessions[Session Type] = "Match") + 0
			```
		formatString: 0
		displayFolder: Load
		lineageTag: 072282ec-6b0b-583c-8201-043a4dc84bbd

	measure 'Top Speed (m/s)' = ```
			MAX(Sessions[max_speed_ms])
			```
		formatString: 0.0
		displayFolder: Load
		lineageTag: 2b2915d0-05bd-58d2-98ae-77b36f4088ed

	measure 'Avg Distance per Session (m)' = ```
			AVERAGE(Sessions[total_distance_m])
			```
		formatString: #,0
		displayFolder: Periodization
		lineageTag: 0efb2866-355d-5ed0-ba67-9ec5d7e9ef31

	measure 'Avg HSR per Session (m)' = ```
			AVERAGE(Sessions[hsr_distance_m])
			```
		formatString: #,0
		displayFolder: Periodization
		lineageTag: 04d57eb7-549a-5657-aca3-9d6f587ab319

	measure 'Avg sRPE per Session' = ```
			AVERAGE(Sessions[srpe_au])
			```
		formatString: #,0
		displayFolder: Periodization
		lineageTag: ca0d22b0-6050-563f-beb5-70f104dec310

	measure 'Squad Avg sRPE (AU)' = ```
			AVERAGEX(VALUES(Players[Player]), [sRPE (AU)])
			```
		formatString: #,0
		displayFolder: Periodization
		lineageTag: bb6bb30e-9dd4-5ab2-8783-a685f13d71c5

	measure 'Weekly Load WoW %' = ```
			VAR cur = [sRPE (AU)]
			VAR prev = CALCULATE([sRPE (AU)], DATEADD('Date'[Date], -7, DAY))
			RETURN DIVIDE(cur - prev, prev)
			```
		formatString: 0.0%
		displayFolder: Periodization
		lineageTag: 2cfef0fd-5557-5ca7-b4c3-6512af91823b

	partition Sessions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sessions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"player_id", "date", "session_type", "md_code", "duration_min", "total_distance_m", "hsr_distance_m", "sprint_distance_m", "sprint_efforts", "accels", "decels", "max_speed_ms", "rpe", "srpe_au"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"player_id", type text}, {"date", type date}, {"session_type", type text}, {"md_code", type text}, {"duration_min", Int64.Type}, {"total_distance_m", type number}, {"hsr_distance_m", type number}, {"sprint_distance_m", type number}, {"sprint_efforts", Int64.Type}, {"accels", Int64.Type}, {"decels", Int64.Type}, {"max_speed_ms", type number}, {"rpe", Int64.Type}, {"srpe_au", Int64.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"player_id", "Player"}, {"date", "Date"}, {"session_type", "Session Type"}, {"md_code", "MD Code"}}),
				    WithOrder = Table.AddColumn(Renamed, "md_order", each Record.FieldOrDefault([#"MD-4" = 1, #"MD-3" = 2, #"MD-2" = 3, #"MD-1" = 4, MD = 5, #"MD+1" = 6, COMP = 7, REHAB = 8], [MD Code], 9), Int64.Type)
				in
				    WithOrder
