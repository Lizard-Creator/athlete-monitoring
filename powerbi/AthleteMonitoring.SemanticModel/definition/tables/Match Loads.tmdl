	partition 'Match Loads' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "match_loads.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"player_id", "source_game", "minutes", "total_distance_m", "hsr_distance_m", "sprint_distance_m", "sprint_efforts", "accels", "decels", "max_speed_ms"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"player_id", type text}, {"source_game", type text}, {"minutes", type number}, {"total_distance_m", type number}, {"hsr_distance_m", type number}, {"sprint_distance_m", type number}, {"sprint_efforts", Int64.Type}, {"accels", Int64.Type}, {"decels", Int64.Type}, {"max_speed_ms", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"player_id", "Player"}})
				in
				    Renamed
