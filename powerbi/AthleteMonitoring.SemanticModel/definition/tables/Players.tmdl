	partition Players = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "players.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"player_id", "position", "status", "source_game", "jersey", "max_speed_ms"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"player_id", type text}, {"position", type text}, {"status", type text}, {"source_game", type text}, {"jersey", Int64.Type}, {"max_speed_ms", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"player_id", "Player"}, {"position", "Position"}, {"status", "Squad Status"}})
				in
				    Renamed
